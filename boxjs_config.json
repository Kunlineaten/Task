{
  "apps": [
    {
      "id": "world_news_pusher",
      "name": "🌍 世界新闻每日推送",
      "icon": "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/News.png",
      "author": "Nancy",
      "desc": "每天 10:00 和 17:00 推送 5 条不重复的国际主流新闻",
      "settings": [
        {
          "id": "newsapi_key",
          "name": "📌 NewsAPI Key (必填)",
          "val": "",
          "type": "text",
          "desc": "访问 https://newsapi.org/register 免费注册，获取 API Key"
        },
        {
          "id": "news_sources",
          "name": "📰 新闻来源",
          "val": "bbc-news,reuters,associated-press,cnn,the-guardian-uk",
          "type": "textarea",
          "desc": "逗号分隔，更多来源: https://newsapi.org/docs/endpoints/sources"
        },
        {
          "id": "news_exclude_keywords",
          "name": "🚫 排除关键词",
          "val": "crypto,bitcoin,nft",
          "type": "textarea",
          "desc": "包含这些词的新闻会被过滤"
        }
      ]
    }
  ]
}
