+++ b/qx/gkd011_checkin_qx.js
@@ -0,0 +1,122 @@
+/*
+[task_local]
+# 每天 09:05 執行一次
+5 9 * * * https://raw.githubusercontent.com/<你的倉庫>/Task/main/qx/gkd011_checkin_qx.js, tag=GKD011 自動簽到, enabled=true
+
+[mitm]
+hostname = www.gkd011.top
+*/
+
+const CFG = {
+  baseUrl: "https://www.gkd011.top",
+  loginPath: "/api/login",
+  checkinPath: "/api/checkin", 
+  username: $prefs.valueForKey("GKD011_USER") ,
+  password: $prefs.valueForKey("GKD011_PASS") ,
+  timeout: 20000
+};
+
+function done(msg) {
+  console.log(msg);
+  $notify("GKD011 簽到", "", msg);
+  $done();
+}
+
+function parseJSON(text) {
+  try { return JSON.parse(text || "{}"); } catch { return {}; }
+}
+
+function pickToken(obj) {
+  if (!obj || typeof obj !== "object") return "";
+  const tokenKeys = ["token", "access_token", "accessToken", "jwt", "auth", "data.token"];
+
+  for (const k of tokenKeys) {
+    if (k.includes(".")) {
+      const [a, b] = k.split(".");
+      if (obj[a] && typeof obj[a] === "object" && obj[a][b]) return String(obj[a][b]);
+      continue;
+    }
+    if (obj[k]) return String(obj[k]);
+  }
+
+  for (const key of Object.keys(obj)) {
+    const val = obj[key];
+    if (val && typeof val === "object") {
+      const nested = pickToken(val);
+      if (nested) return nested;
+    }
+  }
+  return "";
+}
+
+function request(options) {
+  return new Promise((resolve, reject) => {
+    $task.fetch(options).then(resolve, reject);
+  });
+}
+
+async function run() {
+  if (!CFG.username || !CFG.password) {
+    return done("❌ 帳號或密碼為空，請先在 Quantumult X 資料持久化寫入 GKD011_USER / GKD011_PASS");
+  }
+
+  const loginReq = {
+    url: `${CFG.baseUrl}${CFG.loginPath}`,
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+      "Accept": "application/json"
+    },
+    body: JSON.stringify({
+      email: CFG.username,
+      username: CFG.username,
+      account: CFG.username,
+      password: CFG.password
+    }),
+    timeout: CFG.timeout
+  };
+
+  console.log("🚀 login => " + loginReq.url);
+  const loginResp = await request(loginReq);
+  const loginJson = parseJSON(loginResp.body);
+  const token = pickToken(loginJson);
+
+  if (!token) {
+    return done(`❌ 登入疑似失敗，未取得 token。HTTP ${loginResp.statusCode}，請抓包確認 loginPath 與請求參數`);
+  }
+
+  $prefs.setValueForKey(token, "GKD011_TOKEN");
+
+  const checkinReq = {
+    url: `${CFG.baseUrl}${CFG.checkinPath}`,
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+      "Accept": "application/json",
+      "Authorization": `Bearer ${token}`,
+      "token": token
+    },
+    body: JSON.stringify({}),
+    timeout: CFG.timeout
+  };
+
+  console.log("🚀 checkin => " + checkinReq.url);
+  const checkinResp = await request(checkinReq);
+  const checkinJson = parseJSON(checkinResp.body);
+
+  const ok =
+    checkinResp.statusCode === 200 ||
+    checkinJson.success === true ||
+    checkinJson.code === 0 ||
+    checkinJson.status === 1;
+
+  if (ok) {
+    return done(`✅ 簽到成功：${checkinJson.message || checkinJson.msg || "OK"}`);
+  }
+
+  return done(`⚠️ 簽到返回異常：HTTP ${checkinResp.statusCode}，${checkinJson.message || checkinJson.msg || checkinResp.body || "未知錯誤"}`);
+}
+
+run().catch(err => {
+  done("❌ 執行失敗：" + (err && err.message ? err.message : String(err)));
+});
 
EOF
)
